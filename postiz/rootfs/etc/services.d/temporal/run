#!/usr/bin/with-contenv bashio

# Temporal (production server build) backed by the same PostgreSQL instance
# Postiz uses, with the temporal and temporal_visibility databases.
# Schema is applied once in 20-bootstrap-databases.sh; this script just
# starts the four service roles in a single process.
bashio::log.info "Temporal: waiting for PostgreSQL"
until pg_isready -h 127.0.0.1 -p 5432 -U temporal -d temporal >/dev/null 2>&1; do
    sleep 1
done

bashio::log.info "Starting temporal-server (Postgres backend, single-process frontend/history/matching/worker)"
exec /usr/local/bin/temporal-server \
    --root /etc/temporal \
    --env production \
    start \
    --service frontend \
    --service history \
    --service matching \
    --service worker
